{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xcrol",
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true
  },
  // Serves the Vite build output as a SPA on xcrol.com + www (zone hosted
  // on Cloudflare since 2026-08-09). The worker script only intercepts
  // /post/* for link-preview scrapers (OG meta HTML via the og-post edge
  // function) and /embed/* for the embeddable profile card (embed-profile
  // edge function, CDN-cached); everything else is static assets.
  "main": "worker/index.ts",
  "routes": [
    { "pattern": "xcrol.com", "custom_domain": true },
    { "pattern": "www.xcrol.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true  // all requests: the www->apex redirect must see every path; worker falls through to ASSETS
  },
  "vars": {
    "SUPABASE_URL": "https://wmatvlxehyaufhjljtby.supabase.co",
    // Public anon key (already shipped in the client bundle) for in-worker
    // PostgREST reads of anon-visible rows (group OG cards).
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndtYXR2bHhlaHlhdWZoamxqdGJ5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjY5NzU4MjQsImV4cCI6MjA4MjU1MTgyNH0.7j8b65giQ9ZXLkWpbKdiZLWp6kT9lm8jhqoM7Yxt8tU"
  }
}
