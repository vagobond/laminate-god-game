{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xcrol",
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true
  },
  // Static-assets-only Worker: serves the Vite build output as a SPA
  // on xcrol.com + www (zone hosted on Cloudflare since 2026-08-09).
  "routes": [
    { "pattern": "xcrol.com", "custom_domain": true },
    { "pattern": "www.xcrol.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
